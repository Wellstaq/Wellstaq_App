{
  "name": "wellstaq-web",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:org": "npm run dev --workspace @wellstaq/org",
    "dev:admin": "npm run dev --workspace @wellstaq/admin",
    "build:org": "npm run build --workspace @wellstaq/org",
    "build:admin": "npm run build --workspace @wellstaq/admin",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:org": "npm run check --workspace @wellstaq/org",
    "check:admin": "npm run check --workspace @wellstaq/admin",
    "check": "npm run check --workspaces --if-present"
  }
}
