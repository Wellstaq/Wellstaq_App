# Server-only values. Never prefix these with NEXT_PUBLIC_.

# Base URL of the Wellstaq API. The admin proxy only ever calls
# ${BACKEND_API_URL}/app-admin/...
BACKEND_API_URL="https://wellstaq.up.railway.app"

# Interim: the backend's support ticket endpoints are guarded by a static
# x-app-admin-key header until admin login exists. The proxy attaches it
# server-side; it is never sent to the browser. Remove once admin auth ships.
APP_ADMIN_API_KEY=""

# Local design preview without a backend: lists are empty, counts are zero,
# writes are refused. Ignored when NODE_ENV=production.
ADMIN_PREVIEW_MODE="false"
